#!/usr/bin/env bash
# sbx: un contenedor Docker por proyecto para los cron y scripts, así la Mac queda limpia.
# La plantilla y la imagen base viven en este mismo repo (este archivo está en <repo>/bin/sbx).
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
BASE_DIR="$REPO/sandbox/base"
TEMPLATE_DIR="$REPO/sandbox/template"

die() { echo "sbx: $*" >&2; exit 1; }

usage() {
  cat <<'USO'
uso: sbx <comando>

  init [alpine|ubuntu]           crea .sandbox/ en el proyecto actual
  up | down | restart            levanta, baja o reinicia el contenedor
  sh                             abre una shell dentro del contenedor
  claude [args]                  Claude Code dentro del contenedor (para hacer /login)
  run <nombre> <comando...>      corre un job una vez ahora (igual que el cron)
  logs [-f]                      salida de supercronic
  ps                             todos los sandbox de la Mac
  levantar                       arranca todos los sandbox caídos de la Mac
  vigia up | down | logs         contenedor que los relevanta solo cuando arranca Docker

  cron ls                        lista los cron del proyecto
  cron add "<expr>" <nombre> <comando...>
  cron rm <nombre>
  cron reload                    relee el crontab después de editarlo a mano

  inbox [--all|--peek|--follow]  resultados de los jobs que terminaron
  base build [alpine|ubuntu|all] reconstruye la imagen base
USO
}

# Sube desde el directorio actual hasta encontrar .sandbox/compose.yaml.
project_root() {
  local d="$PWD"
  while [ "$d" != "/" ]; do
    [ -f "$d/.sandbox/compose.yaml" ] && { echo "$d"; return; }
    d="$(dirname "$d")"
  done
  die "no hay .sandbox/ en este proyecto (usá: sbx init)"
}

load_project() {
  ROOT="$(project_root)"
  SBX="$ROOT/.sandbox"
  NAME="sbx-$(basename "$ROOT" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_\n-' '-')"
}

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/sbx"

# Tapa con /dev/null los .env del repo, así el contenedor solo ve los secretos de
# ~/.config/sbx/<proyecto>.env. El archivo vive en la Mac, fuera del alcance del contenedor.
mascaras() {
  local out="$STATE/$NAME.mascaras.yaml" f rel n=0
  local raiz; raiz="$(cd "$ROOT" && pwd -P)"
  mkdir -p "$STATE"
  # Se saltean .git, node_modules y todo lo que el contenedor puede escribir (.sandbox y las
  # carpetas montadas con escritura en compose.yaml): un archivo creado desde adentro no
  # puede decidir qué se monta. Lo demás lo escribió alguien en la Mac.
  local podar=(-name .git -o -name node_modules -o -path "$raiz/.sandbox") fuentes src
  # Las carpetas con escritura salen de la configuración que arma docker compose, no del
  # texto del YAML. Si no se puede leer, no se levanta.
  fuentes="$(compose_base config --format json | jq -r '.services[].volumes[]?
      | select(.type == "bind" and (.read_only | not)) | .source')" \
    || { echo "sbx: no se pudo leer la configuración de compose" >&2; return 1; }
  while IFS= read -r src; do
    [ -n "$src" ] || continue
    src="$(cd "$src" 2>/dev/null && pwd -P)" || continue
    [[ "$src" == "$raiz" ]] && { echo "sbx: el repo entero está montado con escritura" >&2; return 1; }
    [[ "$src" == "$raiz"/* ]] && podar+=(-o -path "$src")
  done <<< "$fuentes"

  {
    echo "services:"
    echo "  sandbox:"
    echo "    volumes:"
    echo "      - /dev/null:/tmp/.sbx-sin-mascaras:ro"
    while IFS= read -r -d '' f; do
      rel="${f#"$raiz"/}"
      # jq cita la ruta; igual se frena (no se saltea) ante caracteres de control.
      [[ "$rel" != *[[:cntrl:]]* ]] || { echo "sbx: nombre de archivo raro, no se levanta: $rel" >&2; return 1; }
      jq -cn --arg t "/workspace/$rel" '{type: "bind", source: "/dev/null", target: $t, read_only: true}' \
        | sed 's/^/      - /'
      n=$((n + 1))
      [ "$n" -le 200 ] || { echo "sbx: más de 200 archivos .env en el repo, no se levanta" >&2; return 1; }
    done < <(find "$raiz" \( "${podar[@]}" \) -prune -o \
                  \( -type f -o -type l \) -name '.env*' ! -name '.env.example' -print0 2>/dev/null)
  } > "$out"
  echo "$out"
}

# Sin máscaras: para bajar, ver logs o mandar señales, que no crean contenedores nuevos.
host_tz() { readlink /etc/localtime 2>/dev/null | sed 's|.*/zoneinfo/||'; }

compose_base() {
  SBX_ENV_FILE="$HOME/.config/sbx/${NAME#sbx-}.env" SBX_TZ="$(host_tz)" \
    docker compose -p "$NAME" -f "$SBX/compose.yaml" "$@"
}

# Con máscaras: para up, exec y run.
compose() {
  local m; m="$(mascaras)" || exit 1
  compose_base -f "$m" "$@"
}

base_os() { sed -n 's/^FROM sbx-base:\([a-z]*\).*/\1/p' "$SBX/Dockerfile" | head -1; }

base_build() {
  local os="$1" from
  case "$os" in
    alpine) from=alpine:3.22 ;;
    ubuntu) from=ubuntu:24.04 ;;
    *) die "sistema operativo no soportado: $os" ;;
  esac
  local tz; tz="$(host_tz)"
  docker build --target claude -t "sbx-base:$os" --build-arg BASE="$from" --build-arg TZ="${tz:-UTC}" "$BASE_DIR"
}

ensure_base() {
  local os; os="$(base_os)"
  [ -n "$os" ] || return 0
  docker image inspect "sbx-base:$os" >/dev/null 2>&1 || base_build "$os"
}

cron_reload() {
  if [ -n "$(compose_base ps -q sandbox 2>/dev/null)" ]; then
    compose_base kill -s USR2 sandbox >/dev/null && echo "crontab recargado en $NAME"
  else
    echo "el contenedor está apagado; el crontab se lee al hacer: sbx up"
  fi
}

cmd_init() {
  local os="${1:-alpine}"
  [ "$os" = alpine ] || [ "$os" = ubuntu ] || die "usá alpine o ubuntu"
  [ -e .sandbox ] && die ".sandbox/ ya existe en $PWD"
  cp -R "$TEMPLATE_DIR" .sandbox
  sed -i '' "s/^FROM sbx-base:alpine/FROM sbx-base:$os/" .sandbox/Dockerfile
  echo "creado .sandbox/ ($os). Siguiente paso: sbx up"
}

cmd_cron() {
  load_project
  local crontab="$SBX/crontab"
  case "${1:-ls}" in
    ls)
      grep -vE '^\s*(#|$)' "$crontab" || echo "(sin cron)" ;;
    add)
      shift
      [ $# -ge 3 ] || die 'uso: sbx cron add "<expr>" <nombre> <comando...>'
      local expr="$1" name="$2"; shift 2
      [[ "$name" =~ ^[a-zA-Z0-9_-]+$ ]] || die "nombre inválido: $name (letras, números, - y _)"
      local fields; fields=$(wc -w <<<"$expr" | tr -d ' ')
      [[ "$expr" == @* || "$fields" -eq 5 || "$fields" -eq 6 ]] || die "expresión de cron inválida: $expr"
      grep -qE "sbx-run $name( |$)" "$crontab" && die "ya existe un cron llamado $name"
      echo "$expr sbx-run $name $*" >> "$crontab"
      echo "agregado: $expr sbx-run $name $*"
      cron_reload ;;
    rm)
      [ -n "${2:-}" ] || die "uso: sbx cron rm <nombre>"
      grep -qE "sbx-run $2( |$)" "$crontab" || die "no existe un cron llamado $2"
      sed -i '' -E "/sbx-run $2( |$)/d" "$crontab"
      echo "borrado: $2"
      cron_reload ;;
    reload) cron_reload ;;
    *) die "subcomando de cron desconocido: $1" ;;
  esac
}

# Muestra los eventos que dejó sbx-run. Por defecto solo los no leídos y los marca como leídos.
cmd_inbox() {
  load_project
  # out/ lo escribe el contenedor: no se confía en nada de ahí. El marcador de leídos
  # vive fuera de out/ y no se siguen enlaces simbólicos.
  local events="$SBX/out/events.jsonl"
  local state="${XDG_STATE_HOME:-$HOME/.local/state}/sbx"
  local marker="$state/$NAME.inbox-leidos"
  [ -L "$SBX/out" ] || [ -L "$SBX/out/runs" ] && die "out/ contiene enlaces simbólicos; no se lee"
  [ -f "$events" ] && [ ! -L "$events" ] || { echo "(sin eventos)"; return; }
  # Solo pasan eventos con forma conocida; lo demás se descarta.
  local filtro='fromjson? | select(
      (.ts | type == "string" and test("^[0-9T:+-]{19,25}$"))
      and (.job | type == "string" and test("^[A-Za-z0-9_-]{1,64}$"))
      and (.exit | type == "number") and (.secs | type == "number")
      and (.log | type == "string" and test("^\\.sandbox/out/runs/[A-Za-z0-9_.-]{1,128}\\.log$")))
    | "\(.ts)  \(.job)  exit=\(.exit)  \(.secs)s  \(.log)"'
  case "${1:-}" in
    --follow) exec tail -n0 -F "$events" | jq --unbuffered -R -r "$filtro" ;;
    --all) jq -R -r "$filtro" "$events"; return ;;
  esac
  local total seen=0
  total=$(wc -l < "$events" | tr -d ' ')
  [ -f "$marker" ] && [ ! -L "$marker" ] && seen=$(tr -cd '0-9' < "$marker")
  [ -n "$seen" ] && [ "$seen" -le "$total" ] || seen=0
  if [ "$total" -eq "$seen" ]; then echo "(sin novedades)"; return; fi
  tail -n +"$((seen + 1))" "$events" | head -n "$((total - seen))" | jq -R -r "$filtro" \
    | while IFS= read -r linea; do
        # El log tiene que ser un archivo común, no un enlace a algo de la Mac.
        local log="$ROOT/${linea##* }"
        [ -f "$log" ] && [ ! -L "$log" ] && echo "$linea"
      done
  if [ "${1:-}" != --peek ]; then
    mkdir -p "$state"
    rm -f "$marker"
    echo "$total" > "$marker"
  fi
}

# Arranca los sandbox que quedaron caídos (por ejemplo, tras un reinicio de Docker que no
# los relevantó). `sbx down` borra el contenedor, así que uno en "exited" es uno caído.
# Usa el contenedor tal como estaba: no recalcula máscaras ni reconstruye la imagen.
cmd_levantar() {
  local n=0 nombre dir
  while IFS=$'\t' read -r nombre dir; do
    [ -n "$nombre" ] || continue
    # Sin la carpeta del proyecto, Docker crearía carpetas vacías en la Mac al montar.
    if [ ! -f "$dir/compose.yaml" ]; then
      echo "salteado: $nombre (ya no existe $dir; borralo con docker rm)"
      continue
    fi
    if docker start "$nombre" >/dev/null; then
      echo "levantado: $nombre"; n=$((n + 1))
    else
      echo "sbx: no se pudo levantar $nombre" >&2
    fi
  done < <(docker ps -a --filter "name=^sbx-" --filter status=exited \
             --format '{{.Names}}\t{{.Label "com.docker.compose.project.working_dir"}}')
  [ "$n" -gt 0 ] || echo "(no había sandbox caídos para levantar)"
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    levantar) cmd_levantar ;;
    vigia)
      local vigia=(docker compose -p sbx-vigia -f "$REPO/sandbox/vigia/compose.yaml")
      case "${1:-}" in
        up) "${vigia[@]}" up -d --build ;;
        down) "${vigia[@]}" down ;;
        logs) shift; "${vigia[@]}" logs "$@" vigia ;;
        *) die "uso: sbx vigia up | down | logs [-f]" ;;
      esac ;;
    init) cmd_init "$@" ;;
    up) load_project; ensure_base; mkdir -p "$SBX/out"; compose up -d --build ;;
    down) load_project; compose_base down ;;
    restart) load_project; compose_base restart ;;
    sh) load_project; compose exec sandbox bash ;;
    claude) load_project; compose exec sandbox claude "$@" ;;
    run)
      load_project
      [ $# -ge 2 ] || die "uso: sbx run <nombre> <comando...>"
      compose exec sandbox sbx-run "$@" ;;
    logs) load_project; compose_base logs "$@" sandbox ;;
    ps) docker ps -a --filter "name=^sbx-" --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}' ;;
    cron) cmd_cron "$@" ;;
    inbox) cmd_inbox "$@" ;;
    base)
      [ "${1:-}" = build ] || die "uso: sbx base build [alpine|ubuntu|all]"
      case "${2:-all}" in
        all) base_build alpine; base_build ubuntu ;;
        *) base_build "$2" ;;
      esac ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
